OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Local rules by default. Set openai explicitly to enable cloud analysis.
EXTRACTION_METHOD=regex
APP_HOST=127.0.0.1
APP_PORT=8000
# Relative paths resolve from the repository root.
APP_DATA_DIR=.local/invoice-app
MAX_UPLOAD_FILES=10
MAX_FILE_MB=20
MAX_PDF_PAGES=10
CONFIDENCE_THRESHOLD=0.75
LIGHTONOCR_PORT=18987
LIGHTONOCR_CONTEXT=8192
LIGHTONOCR_MAX_TOKENS=4096
LIGHTONOCR_TIMEOUT=900
# Optional: point to an existing local llama.cpp server instead of launching one.
LIGHTONOCR_BASE_URL=
